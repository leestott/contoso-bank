# Copy to .env. Keep .env local; never commit real deployment values.
# Exported environment variables override .env. Values are literal, not shell code.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=

# Optional live procurement agent. Leave blank for local rule-based mode.
COMMERCE_RESOURCE_GROUP=
COMMERCE_FOUNDRY_ACCOUNT=
COMMERCE_FOUNDRY_PROJECT=
COMMERCE_FOUNDRY_ENDPOINT=
COMMERCE_MODEL_DEPLOYMENT=
COMMERCE_AGENT_NAME=
COMMERCE_AGENT_VERSION=1

# Banking deployment. Populate only with your own Azure resources.
# Optional banking-only identity boundary; blank values use AZURE_* above.
BANKING_AZURE_SUBSCRIPTION_ID=
BANKING_AZURE_TENANT_ID=
BANKING_RESOURCE_GROUP=
BANKING_FOUNDRY_ACCOUNT=
BANKING_FOUNDRY_PROJECT=
BANKING_FOUNDRY_ENDPOINT=
BANKING_REGION=swedencentral
BANKING_MODEL_DEPLOYMENT=
BANKING_PROJECT_STATE=Unknown
BANKING_VOICE_AGENT_NAME=
# Written by provisioning only after the native agent is read back.
BANKING_VOICE_AGENT_VERSION=
BANKING_VOICE_AZ_AGENT_VERSION=
BANKING_VOICE_RU_AGENT_VERSION=

# Written only after actual hosted-agent version readback.
BANKING_HOSTED_ORCHESTRATOR_VERSION=
BANKING_HOSTED_CARD_VERSION=
BANKING_HOSTED_LENDING_VERSION=
BANKING_HOSTED_PAYMENTS_VERSION=

# Written by the authenticated web deployment; never put actual values in source.
BANKING_WEB_APP=
BANKING_WEB_URL=
BANKING_WEB_CLIENT_ID=
# CLOUD_* authentication settings and credentials are configured in App Service,
# not copied into a public template. Local manual mode does not require them.

# Optional event survey; leave blank to hide survey links.
DEMO_SURVEY_URL=
